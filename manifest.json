{
  "manifest_version": 3,
  "name": "MJ Export",
  "version": "0.3.0",
  "description": "Local, read-only export of your own Midjourney work.",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.midjourney.com/*",
    "https://cdn.midjourney.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.midjourney.com/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.midjourney.com/*"
      ],
      "js": [
        "src/generated/core.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
